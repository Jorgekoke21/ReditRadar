# =============================================================================
# Radar de Conversaciones (radarin-conversation-radar) — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- App ---------------------------------------------------------------
APP_ENV=local
APP_URL=http://localhost:5180
API_URL=http://localhost:8010

# Fallback used only by the SQLite-based backend test suite, which has no
# concept of separate Postgres roles. Real deployments should leave this
# unset and configure the three role-specific URLs below instead — see
# docs/rls.md for why the backend must never connect as the table owner.
DATABASE_URL=postgresql+asyncpg://radarin:radarin@localhost:5544/radarin_radar

# --- Postgres roles (see docs/rls.md) --------------------------------------
# DATABASE_MIGRATION_URL: table owner. Alembic only. Never used by the running app.
# DATABASE_APP_URL: radar_app — what the FastAPI request/response cycle uses.
#   NOSUPERUSER, NOBYPASSRLS, not the table owner — bound by every RLS policy.
# DATABASE_WORKER_URL: radar_worker — what the background worker uses. Same
#   constraints as radar_app, plus one narrow extra grant to list account ids
#   so scheduled jobs can iterate "for each account" without disabling RLS.
DATABASE_MIGRATION_URL=postgresql+asyncpg://radarin:radarin@localhost:5544/radarin_radar
DATABASE_APP_URL=postgresql+asyncpg://radar_app:radar_app_dev_only_change_me@localhost:5544/radarin_radar
DATABASE_WORKER_URL=postgresql+asyncpg://radar_worker:radar_worker_dev_only_change_me@localhost:5544/radarin_radar
# Passwords used both when the migration creates/updates the roles and when
# building the URLs above via docker-compose variable substitution. CHANGE
# THESE before deploying anywhere beyond your own machine.
RADAR_APP_DB_PASSWORD=radar_app_dev_only_change_me
RADAR_WORKER_DB_PASSWORD=radar_worker_dev_only_change_me

# --- Auth (see docs/authentication.md) --------------------------------------
# "development": also accepts POST /api/auth/dev-login (any email, no
#   verification at all) — for local work and tests only.
# "supabase": ONLY real, signature-verified Supabase JWTs are accepted;
#   dev-login is disabled outright.
# The backend refuses to start if APP_ENV=production and AUTH_MODE=development.
AUTH_MODE=development

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Reddit official API (OAuth) -----------------------------------------
# Whole integration is inert while this is false. No network call to Reddit
# is ever made regardless of other values below when this is false.
REDDIT_API_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# The FRONTEND callback route, not the API. Reddit redirects the browser
# here with ?code&state; that page posts them back over an authenticated
# call. Register this exact URI in your Reddit app settings.
REDDIT_REDIRECT_URI=http://localhost:5180/reddit/callback
REDDIT_USER_AGENT=radarin-conversation-radar/0.1 (internal tool; contact: you@example.com)
REDDIT_TOKEN_ENCRYPTION_KEY=
# Fetch tuning; safe defaults for a small read-only watch list.
REDDIT_FETCH_LIMIT=50
REDDIT_MAX_PAGES_PER_COMMUNITY=3
REDDIT_MAX_RETRIES=4
REDDIT_DEFAULT_MAX_AGE_HOURS=72
# Production: comma-separated emails allowed to view/launch diagnostics jobs.
# In local development auth, empty keeps the existing single-user workflow.
JOB_ADMIN_EMAILS=

# --- AI classification (optional) ----------------------------------------
AI_ANALYSIS_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# --- Email ----------------------------------------------------------------
# console = no external send, previews are stored and viewable in /alerts
EMAIL_PROVIDER=console
EMAIL_FROM=radar@radarin.local
EMAIL_TO=you@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# --- Retention / misc -------------------------------------------------------
APP_TIMEZONE=Europe/Madrid
RAW_CONTENT_RETENTION_HOURS=48

# --- Frontend ---------------------------------------------------------------
# The frontend does NOT need its own VITE_SUPABASE_* vars: it fetches the
# active auth_mode + supabase_url + supabase_anon_key from the backend's
# public GET /api/auth/config at load time, so the two can never drift and a
# Supabase project change never requires a frontend redeploy.
